{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "group:allNonMajor"],
  "timezone": "Europe/Athens",
  "schedule": ["before 6am on Sunday"],
  "labels": ["dependencies"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "One weekly PR for all minor/patch/pin/digest updates across npm, Actions, and Docker",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major"
    },
    {
      "description": "Group major npm updates",
      "matchUpdateTypes": ["major"],
      "matchManagers": ["npm", "nvm"],
      "groupName": "npm packages (major)",
      "groupSlug": "major-npm-packages"
    },
    {
      "description": "Group major GitHub Actions updates",
      "matchUpdateTypes": ["major"],
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions (major)",
      "groupSlug": "major-github-actions"
    },
    {
      "description": "Group major Docker image updates",
      "matchUpdateTypes": ["major"],
      "matchManagers": ["dockerfile"],
      "groupName": "Docker images (major)",
      "groupSlug": "major-docker-images"
    },
    {
      "description": "Keep Node.js on major version 24+",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["node"],
      "allowedVersions": ">=24"
    },
    {
      "matchPackageNames": ["renovatebot/github-action"],
      "extends": ["schedule:weekly"]
    }
  ]
}
