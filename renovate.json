{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "group:allNonMajor"],
  "timezone": "Europe/Athens",
  "schedule": ["before 10am"],
  "labels": ["dependencies"],
  "ignoreScripts": false,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Freeze MySQL in Ghost compose — upgrades need manual backup-backed migration (8.4 broke prod via 26.10)",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["ghost/docker-compose.yml"],
      "matchPackageNames": ["mysql"],
      "enabled": false
    },
    {
      "description": "Mirror pnpm minimumReleaseAge (24h): hold npm updates until packages are a day old",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day",
      "internalChecksFilter": "strict"
    },
    {
      "description": "One grouped PR per run for all minor/patch/pin/digest updates across npm, Actions, and Docker (auto-merge when checks pass)",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchPackageNames": ["!pnpm"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "pnpm updates in their own PR — lockfile checksum depends on .pnpmfile.cjs",
      "matchPackageNames": ["pnpm"],
      "groupName": null
    },
    {
      "description": "Pin @biomejs/biome and auto-migrate config & formatting on updates",
      "matchPackageNames": ["@biomejs/biome"],
      "rangeStrategy": "pin",
      "postUpgradeTasks": {
        "commands": [
          "npx --yes @biomejs/biome@{{{newVersion}}} migrate --write",
          "npx --yes @biomejs/biome@{{{newVersion}}} check --write ."
        ],
        "fileFilters": ["biome.json", "**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs", "**/*.json"],
        "executionMode": "update"
      }
    },
    {
      "description": "Group major npm updates",
      "matchUpdateTypes": ["major"],
      "matchManagers": ["npm", "nvm"],
      "groupName": "npm packages (major)",
      "groupSlug": "major-npm-packages"
    },
    {
      "description": "Group major GitHub Actions updates",
      "matchUpdateTypes": ["major"],
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions (major)",
      "groupSlug": "major-github-actions"
    },
    {
      "description": "Group major Docker image updates",
      "matchUpdateTypes": ["major"],
      "matchManagers": ["dockerfile"],
      "groupName": "Docker images (major)",
      "groupSlug": "major-docker-images"
    },
    {
      "description": "Keep Node.js on major version 24+",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["node"],
      "allowedVersions": ">=24"
    },
    {
      "matchPackageNames": ["renovatebot/github-action"],
      "extends": ["schedule:weekly"]
    }
  ]
}
