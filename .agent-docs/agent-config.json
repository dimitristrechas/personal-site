{
  "$comment": "Canonical AI-tool config. Edit this file, then run `pnpm agents:sync`. Generated files: .mcp.json, .cursor/mcp.json, .cursor/hooks.json, .codex/config.toml, .codex/rules/project.rules, .codex/agents/*.toml, .claude/settings.json, opencode.json, plus agent/skill symlinks.",
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "bearerTokenEnv": "GITHUB_MCP_TOKEN"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "bearerTokenEnv": "LINEAR_MCP_TOKEN"
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "bearerTokenEnv": "CONTEXT7_API_KEY"
    },
    "cloudflare-api": {
      "url": "https://mcp.cloudflare.com/mcp",
      "bearerTokenEnv": "CLOUDFLARE_API_TOKEN",
      "requireApproval": true
    },
    "cloudflare-docs": {
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "dokploy": {
      "command": "npx",
      "args": ["-y", "@dokploy/mcp@latest"],
      "envFromShell": ["DOKPLOY_URL", "DOKPLOY_API_KEY"],
      "env": { "DOKPLOY_TOOL_PRESET": "deploy" },
      "requireApproval": true
    }
  },
  "shellCommandsRequiringApproval": [["git", "commit"], ["git", "push"], ["git", "reset"], ["git", "reflog"]]
}
