{
  "name": "personal-site",
  "version": "3.0.0",
  "private": false,
  "description": "Personal website of Dimitris Trechas, a Software Engineer from Greece.",
  "author": {
    "name": "Dimitris Trechas <dimitristrechas@gmail.com> (https://www.dimitristrechas.com)"
  },
  "homepage": "https://dimitristrechas.com",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "outdated": "npx npm-check-updates",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "agents:sync": "node scripts/sync-agent-config.mjs",
    "agents:check": "node scripts/sync-agent-config.mjs --check",
    "postinstall": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || true"
  },
  "dependencies": {
    "@tryghost/content-api": "^1.12.3",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "node-html-parser": "^9.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@eslint/compat": "^2.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.4.6",
    "lefthook": "^2.1.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.1.18",
    "typescript": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
