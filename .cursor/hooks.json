{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/approval-gate.mjs shell",
        "matcher": "\\b(git\\s+commit|git\\s+push|git\\s+reset|git\\s+reflog)\\b"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/hooks/approval-gate.mjs mcp",
        "failClosed": true
      }
    ]
  }
}
