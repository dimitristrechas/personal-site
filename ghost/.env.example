# Dokploy compose env for ghost (set in Dokploy UI > ghost > Environment).
# Values here are placeholders only — never commit real secrets.
GHOST_URL=https://ghost.dimitristrechas.com
mail__transport=
mail__from=
# DB password backing ${MYSQL_ROOT_PASSWORD} in docker-compose.yml.
# Dokploy: set to the CURRENT production value (existing volume keeps it;
# MySQL only reads this on first init, Ghost needs it on every start).
# Local: copy to gitignored ghost/.env (dev default below is fine).
MYSQL_ROOT_PASSWORD=example
